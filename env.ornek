TZ=Europe/Istanbul

# ==============================================================================
# AĞ VE TRAEFIK GÜVENLİK AYARLARI
# ==============================================================================
# Yerel yönetim ve proxy alt ağı (CIDR formatında)
TRUSTED_SUBNET=172.16.1.0/24

# ==============================================================================
# ALAN ADI VE FQDN TANIMLARI
# ==============================================================================
DOMAIN_INT=sirket.intra
DOMAIN_EXT=sirket.com.tr

# 1. Zitadel (IAM / SSO)
ZITADEL_INT_FQDN=auth.${DOMAIN_INT}
ZITADEL_EXT_FQDN=auth.${DOMAIN_EXT}

# 2. Portainer CE
PORTAINER_INT_FQDN=portainer.${DOMAIN_INT}
PORTAINER_EXT_FQDN=portainer.${DOMAIN_EXT}

# 3. Apache Guacamole
GUACAMOLE_INT_FQDN=guacamole.${DOMAIN_INT}
GUACAMOLE_EXT_FQDN=guacamole.${DOMAIN_EXT}

# 4. pgAdmin 4
PGADMIN_INT_FQDN=pgadmin.${DOMAIN_INT}
PGADMIN_EXT_FQDN=pgadmin.${DOMAIN_EXT}
PGADMIN_DEFAULT_EMAIL=admin@sirket.intra
PGADMIN_DEFAULT_PASSWORD=

# 5. Vaultwarden
VAULTWARDEN_INT_FQDN=vault.${DOMAIN_INT}
VAULTWARDEN_EXT_FQDN=vault.${DOMAIN_EXT}

# 5. Whoami Test Servisi
WHOAMI_INT_FQDN=whoami.${DOMAIN_INT}
WHOAMI_EXT_FQDN=whoami.${DOMAIN_EXT}

# 6. OPNsense Firewall
OPNSENSE_INT_FQDN=opnsense.${DOMAIN_INT}
OPNSENSE_EXT_FQDN=opnsense.${DOMAIN_EXT}
OPNSENSE_INTERNAL_IP=172.16.1.1
OPNSENSE_INTERNAL_PORT=443

# 7. Traefik Dashboard
TRAEFIK_INT_FQDN=traefik.${DOMAIN_INT}
TRAEFIK_EXT_FQDN=traefik.${DOMAIN_EXT}
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=

# CrowdSec Veritabanı
CROWDSEC_DB_USER=crowdsec
CROWDSEC_DB_PASSWORD=
CROWDSEC_DB_NAME=crowdsec_db

# ==============================================================================
# UNIVENTION CORPORATE SERVER (UCS) SAMBA 4 ACTIVE DIRECTORY
# ==============================================================================
UCS_HOST=ucs.${DOMAIN_INT}
UCS_IP=172.16.1.10
UCS_LDAP_PORT=389
UCS_LDAPS_PORT=636
UCS_BASE_DN=dc=sirket,dc=intra
UCS_USERS_DN=cn=users,${UCS_BASE_DN}
UCS_GROUPS_DN=cn=groups,${UCS_BASE_DN}
UCS_BIND_DN=cn=Administrator,${UCS_USERS_DN}
UCS_BIND_PASSWORD=UcsAdminSecurePassword123!
UCS_WORKGROUP=SIRKET
UCS_REALM=SIRKET.INTRA
UCS_ADMIN_GROUP=Pfsense-Admins

# ==============================================================================
# MERKEZİ POSTGRESQL (ZITADEL, GUACAMOLE, VAULTWARDEN)
# ==============================================================================
POSTGRES_USER=zitadel
POSTGRES_PASSWORD=
POSTGRES_DB=zitadel

# Guacamole Veritabanı
GUACAMOLE_DB_USER=guacamole
GUACAMOLE_DB_PASSWORD=
GUACAMOLE_DB_NAME=guacamole_db

# Vaultwarden Veritabanı
VAULTWARDEN_DB_USER=vaultwarden
VAULTWARDEN_DB_PASSWORD=
VAULTWARDEN_DB_NAME=vaultwarden_db

# ==============================================================================
# ZITADEL (IAM & SSO)
# ==============================================================================
# ZITADEL_MASTERKEY tam 32 karakter (256-bit) olmalıdır
ZITADEL_MASTERKEY=
ZITADEL_ORG_NAME=SIRKET
ZITADEL_ADMIN_USER=admin
ZITADEL_ADMIN_PASSWORD=

# ==============================================================================
# VAULTWARDEN AYARLARI
# ==============================================================================
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_SIGNUPS_ALLOWED=false
INVITATION_ORG_NAME=vaultwarden
EMERGENCY_ACCESS_ALLOWED=true


# ==============================================================================
# GÜVENLİK, CERTRESOLVER VE TÜNELLER (CROWDSEC, TAILSCALE, CLOUDFLARE, TLS)
# ==============================================================================
CROWDSEC_BOUNCER_API_KEY=
ACME_EMAIL=admin@sirket.com.tr
CF_DNS_API_TOKEN=
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx
TAILSCALE_ADVERTISED_ROUTES=172.16.1.0/24
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# ==============================================================================
# ZITADEL AYARLARI
# ==============================================================================
OAUTH2_PROXY_CLIENT_ID=<ZITADEL_DEN_ALINAN_CLIENT_ID>
OAUTH2_PROXY_CLIENT_SECRET=<ZITADEL_DEN_ALINAN_CLIENT_SECRET>
OAUTH2_PROXY_COOKIE_SECRET=<URETILEN_32_BAYTLIK_SECRET>